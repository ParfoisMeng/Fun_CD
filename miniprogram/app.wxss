page { background:#f6f3eb; color:#293d37; font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; }
.page { padding:40rpx; padding-bottom:calc(40rpx + env(safe-area-inset-bottom)); }
.eyebrow { color:#7a8b80; font-size:22rpx; letter-spacing:5rpx; }
.title { font-size:60rpx; font-weight:700; margin:26rpx 0; }
.muted { color:#758078; font-size:27rpx; line-height:1.7; }
.card { background:#fffdf7; border:1rpx solid #e4e7db; border-radius:32rpx; padding:32rpx; margin:30rpx 0; }
button { border-radius:24rpx; font-size:30rpx; margin:20rpx 0; }
button::after { border:0; }
.primary { background:#294c3f; color:#fffdf7; }
.secondary { background:#e5eada; color:#294c3f; }
.error { color:#a24731; font-size:26rpx; line-height:1.6; }
.small { font-size:23rpx; }
